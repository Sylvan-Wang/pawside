# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Needed for account deletion (/api/account/delete). Bypasses row-level
# security: never add NEXT_PUBLIC_ to it and never import it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Oura (设置 → 运动健康设备). Server-only. Create the app at https://cloud.ouraring.com/oauth/applications
# Redirect URI must match exactly: https://paw-side.com/api/devices/oura/callback (scope: daily only)
OURA_CLIENT_ID=your-oura-client-id
OURA_CLIENT_SECRET=your-oura-client-secret
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored device tokens.
# Changing it makes stored tokens unreadable: people just reconnect.
DEVICE_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# Server-only OpenAI configuration. Never add NEXT_PUBLIC_ to this key.
OPENAI_API_KEY=your-openai-api-key

# Cost-sensitive default for Pawside's short structured outputs.
OPENAI_MODEL=gpt-5.6-luna

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=20000

# If the OpenAI endpoint is reachable only through a local proxy, create the
# ignored file .env.proxy.local with HTTP_PROXY, HTTPS_PROXY, and NO_PROXY.
